# Optional: ./start.sh --live reads this trusted shell configuration. Do not commit .env.
# start.sh selects AI_MODE/VECTOR_MODE from its flags; the values below apply to manual backend startup.
AI_MODE=live
VECTOR_MODE=qdrant
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_PATH=/chat/completions
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_PATH=/v1/embeddings
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_API_KEY=local
QDRANT_HOST=localhost
QDRANT_PORT=6334
# Optional for start.sh: automatically selected per model when unset.
# Set a NEW collection when changing embedding model/revision; then rebuild the index.
# QDRANT_COLLECTION=mindhaven_embeddinggemma_v1

# Video uploads. Relative paths are resolved from backend/ by start.sh.
MEDIA_DIR=./media
VIDEO_MAX_SIZE=512MB
# Multipart request limit must exceed VIDEO_MAX_SIZE to allow form overhead.
VIDEO_REQUEST_MAX_SIZE=520MB

# New video uploads: local (default) or s3. Existing video pointers are retained.
MEDIA_STORAGE=local
# Private bucket must already exist; backend proxies authenticated video requests.
# MinIO example: http://127.0.0.1:9000. AWS S3: leave endpoint empty.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
# Set both, or leave both empty to use the AWS SDK default credential chain.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# MinIO usually true; AWS S3 normally false.
S3_PATH_STYLE=true
