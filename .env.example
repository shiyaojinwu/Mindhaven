# Optional: ./start.sh --ai or --live reads this trusted shell configuration. Do not commit .env.
# start.sh selects AI_MODE/VECTOR_MODE from its flags; the values below apply to manual backend startup.
AI_MODE=live
VECTOR_MODE=qdrant
# Alternatively export the key before launch or enter it in the hidden terminal prompt.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# OpenAI-compatible gateways are supported; base URL + path must match the completion endpoint.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_PATH=/chat/completions
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_PATH=/v1/embeddings
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_API_KEY=local
QDRANT_HOST=localhost
QDRANT_PORT=6334
# Launcher runtime: auto selects an installed qdrant binary, otherwise Docker Compose.
QDRANT_RUNTIME=auto
# Qdrant mode: dense or hybrid (BM25 + dense, application-side RRF).
# Local mode always uses BM25; no extra embedding call for the lexical channel.
RAG_RETRIEVAL_MODE=hybrid
RAG_CANDIDATE_LIMIT=20
RAG_RRF_K=60
RAG_VECTOR_THRESHOLD=0.35
# Ollama model files default to <project>/.data/ollama/models when launched by start.sh.
# Set this to your existing model directory to reuse downloaded weights.
# OLLAMA_MODELS=/absolute/path/to/models
# Optional for start.sh: automatically selected per model when unset.
# Set a NEW collection when changing embedding model/revision; then rebuild the index.
# QDRANT_COLLECTION=mindhaven_embeddinggemma_v1

# Video uploads. Relative paths are resolved from backend/ by start.sh.
MEDIA_DIR=./media
VIDEO_MAX_SIZE=512MB
# Multipart request limit must exceed VIDEO_MAX_SIZE to allow form overhead.
VIDEO_REQUEST_MAX_SIZE=520MB

# New video uploads: local (default) or s3. Existing video pointers are retained.
MEDIA_STORAGE=local
# Private bucket must already exist; backend proxies authenticated video requests.
# MinIO example: http://127.0.0.1:9000. AWS S3: leave endpoint empty.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
# Set both, or leave both empty to use the AWS SDK default credential chain.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# MinIO usually true; AWS S3 normally false.
S3_PATH_STYLE=true

# Single-process AI task controls. Includes queue time; budget is conservative, not billing usage.
AI_RUN_DEADLINE_SECONDS=180
AI_RUN_TOKEN_BUDGET=24000

# Trace：默认日志记录；可选 OTLP HTTP 接收端，不配置则不外发。
TRACE_SAMPLE_RATE=1.0
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
